# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# Virtual environments
.env
venv/
.venv/

# Raw audio data (too large for git)
data/raw/
# Keep pascal placeholder
!data/raw/pascal/.gitkeep
# Processed audio files (too large for git, only metadata.csv is committed)
data/processed/*.wav
data/processed/audio/*.wav

# Model checkpoints — large experimental checkpoints excluded, but deployed models kept
outputs/checkpoints/*.pt
outputs/checkpoints/*.pth
# Exception: deployed production models MUST be in git so Render can serve them
!outputs/checkpoints/model.pt
!outputs/checkpoints/respiratory_model_best.pth

# Other ignores
training data/
training data/**
*archive*
*.zip
*.tar*
frontend/node_modules/
frontend/dist/
